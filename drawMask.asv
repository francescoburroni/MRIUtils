function mask = drawMask(S,results,maskType)
% Draw a mask on MRI image using maximum standard deviation as a
% guide
arguments (Input)
    S
    results
    maskType (1,1) string {mustBeMember(maskType,["rectangle","polygon"])} = "rectangle"
end

arguments (Output)
    mask (:,:)
end

imshowpair(results.MRI(:,:,1),results.mriStd,"falsecolor")
shg

switch maskType
    case "rectangle"
        roi = drawrectangle();
    case "polygon"
        roi = drawpolygon();
end

mask = roi.createMask;
imshowpair(results.MRI(:,:,1),mask,"falsecolor")

end