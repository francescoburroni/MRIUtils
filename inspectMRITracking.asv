function [] = inspectMRITracking(results,opts)
% Display results of MRI tracking
arguments (Input)
results
opts.colormap (1,1) string {mustBeMember(opts.colormap, ...
    ["parula","turbo","hsv","hot","cool","spring","summer","autumn","winter", ...
     "gray","bone","copper","pink","sky","abyss","nebula","jet","lines", ...
     "colorcube","prism","flag","white"])} = "bone"
end

arguments (Output)

end

% Set up MRI image
fig = uifigure(Units="normalized",OuterPosition=[0 0 .4 1]);

fig.UserData.frameIdx = 1;
fig.UserData.MRI = results.MRI;

grid = uigridlayout(fig,[2, 1]);
ax1 = uiaxes(grid);
mriH = imagesc(ax1,fig.UserData.MRI(:,:,fig.UserData.frameIdx));

fig.UserData.mriH
colormap(ax1,opts.colormap)
fig.UserData.MRI = results.MRI;
% First plot is the image

slider = uislider(grid,Limits=[1 size(results.MRI,3)],ValueChangedFcn=@(src,event) updateValue(src,event,fig));
slider.Value = fig.UserData;





end

function updateValue(src,event,fig,ax)
imagesc(ax1,results.MRI(:,:,slider.Value))
end